# Python
__pycache__/
*.pyc

# PyInstaller 产物 / build output
build/
dist/

# 虚拟环境与依赖缓存 / virtualenv and dependency cache
.venv/
.uv-cache/

# 本地 embedding 模型（92MB，
# download_model.py 可重新下载）
# Local embedding model, re-downloadable via download_model.py
models/

# 运行时/遗留的用户数据：
# 聊天记录、记忆、API Key 都在里面，绝不能进仓库
# Runtime and legacy user data: chat log, memories and the API key
# live here. Must never be committed.
SoulmateData/
database/
memory/*.json
memory/vector_store/

# 日志与构建输出 / logs and build output
*.log
build_*.txt

# SSH 私钥绝不能进仓库
# SSH private keys must never enter the repo
id_ed25519*
*.pem
*.key